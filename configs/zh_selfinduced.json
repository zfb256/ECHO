{
  "random_seed": 20260801,
  "hf_endpoint": "https://huggingface.co",
  "_comment": "Chinese self-induced redesign only. The entire question bank must be human-verified and frozen before any generation; no item may be selected using model error yield.",
  "paths": {
    "datasets_dir": "datasets_zh",
    "models_dir": "models",
    "raw_dir": "datasets_zh/raw",
    "interim_dir": "datasets_zh/interim",
    "processed_dir": "datasets_zh/processed",
    "runs_dir": "datasets_zh/runs",
    "reports_dir": "reports_zh",
    "seed_bank": "configs/zh_seed_bank.json",
    "selfinduced_bank": "configs/zh_selfinduced_questions.json"
  },
  "datasets": [],
  "pilot": {
    "run_name": "zh_selfinduced",
    "turns_target": 2,
    "inference_backend": "vllm",
    "model_pool": [
      "Qwen2.5-1.5B-Instruct",
      "Qwen2.5-3B-Instruct",
      "Qwen2.5-7B-Instruct",
      "Qwen2.5-14B-Instruct",
      "internlm2_5-7b-chat"
    ],
    "model_repositories": {
      "Qwen2.5-1.5B-Instruct": "Qwen/Qwen2.5-1.5B-Instruct",
      "Qwen2.5-3B-Instruct": "Qwen/Qwen2.5-3B-Instruct",
      "Qwen2.5-7B-Instruct": "Qwen/Qwen2.5-7B-Instruct",
      "Qwen2.5-14B-Instruct": "Qwen/Qwen2.5-14B-Instruct",
      "internlm2_5-7b-chat": "internlm/internlm2_5-7b-chat"
    },
    "selfinduced": {
      "enabled": true,
      "questions_per_model": 60,
      "stage2_followup_default": "请根据你刚才的回答，再补充一个相关的具体事实，并用一两句话解释。"
    },
    "prompts": {
      "selfinduced_stage1": "请始终使用简体中文，用一个简短段落直接回答下面的事实问题。如果确实不知道，可以明确说不知道，不要猜测。\n\n问题：{question}",
      "selfinduced_stage2_fallback": "请始终使用简体中文，忠实、简洁地继续对话。\n\n用户：{question}\n助手：{turn1}\n用户：{followup}"
    },
    "ccr": {
      "decoding_temperature_generation": 0.7,
      "decoding_temperature_selfinduced_stage1": 0.0,
      "bootstrap_samples": 2000
    },
    "nli": {
      "enabled": false,
      "model": "IDEA-CCNL/Erlangshen-Roberta-110M-NLI",
      "threshold": 0.70
    },
