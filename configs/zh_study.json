{
  "random_seed": 20260728,
  "hf_endpoint": "https://huggingface.co",
  "_comment": "Chinese full-chain redesign. Banks are locked before model generation. Pilot-only items must use separate files and must never be promoted based on model error yield.",
  "paths": {
    "datasets_dir": "datasets_zh",
    "models_dir": "models",
    "raw_dir": "datasets_zh/raw",
    "interim_dir": "datasets_zh/interim",
    "processed_dir": "datasets_zh/processed",
    "runs_dir": "datasets_zh/runs",
    "reports_dir": "reports_zh",
    "seed_bank": "configs/zh_seed_bank.json",
    "selfinduced_bank": "configs/zh_selfinduced_bank.json"
  },
  "datasets": [
    {"key": "kdconv", "hf_name": "thu-coai/kd_conv_with_kb", "hf_config": "all_dialogues", "split": "train", "sample_size": 400, "language": "zh"},
    {"key": "lccc", "hf_name": "thu-coai/lccc", "hf_config": "base", "split": "train", "sample_size": 400, "language": "zh"}
  ],
  "pilot": {
    "run_name": "zh_study",
    "turns_target": 6,
    "inference_backend": "vllm",
    "model_pool": [
      "Qwen2.5-1.5B-Instruct",
      "Qwen2.5-3B-Instruct",
      "Qwen2.5-7B-Instruct",
      "Qwen2.5-14B-Instruct",
      "internlm2_5-7b-chat"
    ],
    "model_repositories": {
      "Qwen2.5-1.5B-Instruct": "Qwen/Qwen2.5-1.5B-Instruct",
      "Qwen2.5-3B-Instruct": "Qwen/Qwen2.5-3B-Instruct",
      "Qwen2.5-7B-Instruct": "Qwen/Qwen2.5-7B-Instruct",
      "Qwen2.5-14B-Instruct": "Qwen/Qwen2.5-14B-Instruct",
      "internlm2_5-7b-chat": "internlm/internlm2_5-7b-chat"
    },
    "_model_pool_note": "Five-model Chinese-capable pool frozen before generation.",
    "selfinduced": {
      "enabled": true,
      "questions_per_model": 40,
      "stage2_followup_default": "请根据你刚才的回答，再补充一个相关的具体事实，并用一两句话解释。"
    },
    "prompts": {
      "default_entity": "这个主题",
      "entity_probe": "结束前，请用一两句话重述关于“{entity}”最需要记住的关键事实。",
      "clean_instruction": "请始终使用简体中文，忠实、简洁地继续这段多轮对话。",
      "contaminated_instruction": "请始终使用简体中文，忠实、简洁地继续这段多轮对话。",
      "user_role": "用户",
      "assistant_role": "助手",
      "selfinduced_stage1": "请始终使用简体中文，用一个简短段落直接回答下面的事实问题。如果确实不知道，可以明确说不知道，不要猜测。\n\n问题：{question}",
      "selfinduced_stage2_fallback": "请始终使用简体中文，忠实、简洁地继续对话。\n\n用户：{question}\n助手：{turn1}\n用户：{followup}"
    },
    "ccr": {
      "placebo_clean_vs_clean": true,
      "n_clean_samples": 2,
      "decoding_temperature_generation": 0.7,
      "decoding_temperature_selfinduced_stage1": 0.0,
      "min_real_minus_placebo_ccr": 0.05,
      "bootstrap_samples": 2000
    },
    "detector": {
      "negation_window": 6,
      "min_precision": 0.90,
      "min_f1": 0.90,
      "nli_clean_guard": false
    },
    "nli": {
      "enabled": false,
      "model": "IDEA-CCNL/Erlangshen-Roberta-110M-NLI",
      "threshold": 0.70,
      "_note": "Candidate only. Must pass a Chinese construct-gold validation before headline use."
    },
    "annotation": {
      "turn1_second_annotator_n": 80,
      "inheritance_second_annotator_n": 80,
      "injected_recall_audit_n": 120,
      "injected_recall_positive_fraction": 0.50,
      "injected_recall_min_decidable_fraction": 0.75,
      "min_kappa_decidable_fraction": 0.75,
      "correction_audit_n": 50,
      "external_tools_prohibited": true,
      "allow_uncertain": true
    },
    "go_no_go": {
      "min_contaminated_hcr": 0.10,
      "min_ccr": 0.08,
      "min_selfinduced_hcr": 0.10,
      "min_kappa": 0.60,
      "min_real_output_detector_precision": 0.90
    }
  }
}
