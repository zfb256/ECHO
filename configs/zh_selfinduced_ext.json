      "inheritance_second_annotator_n": 0,
      "min_kappa_decidable_fraction": 0.75,
      "external_tools_prohibited": true,
      "allow_uncertain": true
    },
    "go_no_go": {
      "min_selfinduced_hcr": 0.1,
      "min_kappa": 0.6
